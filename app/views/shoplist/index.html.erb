<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>煮干ラーメン屋リスト</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <style>
    .shop-card {
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h3 class="mb-4 text-center">煮干ラーメン屋リスト</h3>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
      <% @shops.each do |shop| %>
        <div class="col">
          <div class="card h-100 shop-card">
            <%= image_tag shop.image, class: "card-img-top", alt: "ラーメンの画像" %>
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <h5 class="card-title"><%= shop.title %></h5>
                <p class="card-text"><%= shop.content %></p>
                <span class="badge bg-primary text-white"><%= shop.genre %></span>
              </div>
              <%= link_to '詳細を見る', shoplist_path(shop.id), class: "btn btn-custom mt-3" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>
