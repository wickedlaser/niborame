<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : 'niborame | 煮干しラーメンの店舗ガイド' %></title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <%= stylesheet_link_tag 'application', 'data-turbo-track': 'reload' %>
</head>
<body>
  <a class="skip-link" href="#main-content">本文へスキップ</a>
  <header class="site-header">
    <div class="container site-header__inner">
      <%= link_to root_path, class: 'site-brand', aria: { label: 'niborame ホーム' } do %>
        <span class="site-brand__name">niborame</span>
        <span class="site-brand__caption">NIBOSHI RAMEN GUIDE</span>
      <% end %>
      <nav class="site-nav" aria-label="メインナビゲーション">
        <%= link_to '店舗を探す', shoplist_index_path, aria: { current: controller_name == 'shoplist' ? 'page' : nil } %>
        <%= link_to 'お問い合わせ', contact_path, aria: { current: controller_name == 'contacts' ? 'page' : nil } %>
      </nav>
    </div>
  </header>

  <main id="main-content" class="container main-content" tabindex="-1">
    <%= yield %>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="site-footer__main">
        <div>
          <%= link_to 'niborame', root_path, class: 'site-brand__name', aria: { label: 'niborame ホーム' } %>
          <p class="site-footer__description">煮干しラーメンの店舗ガイド</p>
        </div>
        <nav class="site-footer__links" aria-label="フッターナビゲーション">
          <%= link_to '店舗を探す', shoplist_index_path %>
          <%= link_to 'お問い合わせ', contact_path %>
          <%= link_to '利用規約', terms_path %>
          <%= link_to 'プライバシーポリシー', privacy_path %>
        </nav>
      </div>
      <div class="site-footer__bottom">
        <small>© <%= Time.current.year %> niborame</small>
        <%= link_to '管理者ログイン', admin_login_path %>
      </div>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
