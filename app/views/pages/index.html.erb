<section class="shoplist-page">
  <header class="shoplist-heading">
    <p class="shoplist-eyebrow">NIBOSHI RAMEN GUIDE</p>
    <h1>煮干しラーメンの<span class="d-inline-block">店舗ガイド</span></h1>
    <p>店名・地域・ジャンルから、煮干しラーメン店を探せます。</p>
  </header>

  <%= form_with url: shoplist_index_path, method: :get, local: true, class: 'shop-search-panel mb-4' do |form| %>
    <div class="row g-3 align-items-end">
      <div class="col-sm">
        <%= form.label :query, '店名・地域', class: 'form-label' %>
        <%= form.search_field :query, maxlength: 100, placeholder: '例：福はら、大阪市', class: 'form-control' %>
      </div>
      <div class="col-sm-auto">
        <%= form.submit '検索する', class: 'btn btn-search w-100' %>
      </div>
    </div>
  <% end %>

  <div class="home-genre-filter">
    <label for="genre-filter" class="form-label">ジャンルで絞り込み</label>
    <select id="genre-filter" class="form-select">
      <option value="">すべて</option>
      <% @genres.each do |genre| %>
        <option value="<%= genre %>"><%= genre %></option>
      <% end %>
    </select>
  </div>

  <div class="shop-results-heading">
    <h2>店舗一覧</h2>
    <%= link_to 'すべてのお店を見る', shoplist_index_path %>
  </div>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-4" id="shops-container">
    <% @shops.each do |shop| %>
      <div class="col" data-genre="<%= shop.genre %>">
        <%= render 'shoplist/shop_card', shop: shop %>
      </div>
    <% end %>
  </div>
</section>

<script>
  (() => {
    const genreFilter = document.getElementById('genre-filter');
    const cards = document.querySelectorAll('#shops-container > [data-genre]');
    genreFilter.addEventListener('change', () => {
      cards.forEach(card => {
        card.hidden = genreFilter.value !== '' && card.dataset.genre !== genreFilter.value;
      });
    });
  })();
</script>
