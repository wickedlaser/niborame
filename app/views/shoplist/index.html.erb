<section class="shoplist-page">
  <header class="shoplist-heading">
    <p class="shoplist-eyebrow">NIBOSHI RAMEN GUIDE</p>
    <h1>煮干しラーメン店を探す</h1>
    <p>店名や地域、ジャンルからお店を見つけられます。</p>
  </header>

  <%= form_with url: shoplist_index_path, method: :get, local: true, class: "shop-search-panel mb-4" do |form| %>
    <div class="row g-3 align-items-end">
      <div class="col-md-6">
        <%= form.label :query, '店名・地域', class: "form-label" %>
        <%= form.search_field :query, value: @query, maxlength: 100, placeholder: '例：福はら、大阪市', class: "form-control" %>
      </div>
      <div class="col-md-3">
        <%= form.label :genre, 'ジャンル', class: "form-label" %>
        <%= form.select :genre, options_for_select([['すべて', '']] + @genres.map { |genre| [genre, genre] }, @genre), {}, class: "form-select" %>
      </div>
      <div class="col-md-3 d-flex gap-2">
        <%= form.submit '検索する', class: "btn btn-search flex-grow-1" %>
        <%= link_to 'リセット', shoplist_index_path, class: 'btn btn-outline-secondary' %>
      </div>
    </div>
  <% end %>

  <div class="shop-results-heading">
    <h2>店舗一覧</h2>
    <p><strong><%= @shops.size %></strong> 店舗</p>
  </div>

  <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-4">
    <% @shops.each do |shop| %>
      <div class="col">
        <article class="card shop-card h-100">
          <% if shop.image.attached? %>
            <%= image_tag shop.image, class: 'shop-card__image', alt: "#{shop.name}の画像", loading: 'lazy' %>
          <% elsif shop.image_url.present? %>
            <%= image_tag shop.image_url, class: 'shop-card__image', alt: "#{shop.name}の画像", loading: 'lazy' %>
          <% else %>
            <div class="shop-card__placeholder" aria-label="画像未登録">画像未登録</div>
          <% end %>

          <div class="card-body d-flex flex-column">
            <div class="shop-card__topline">
              <% if shop.genre.present? %>
                <span class="shop-genre"><%= shop.genre %></span>
              <% end %>
            </div>
            <h3 class="shop-card__title"><%= shop.name %></h3>
            <p class="shop-card__address"><span aria-hidden="true">📍</span> <%= shop.address %></p>
            <p class="shop-card__description"><%= shop.introduction.presence || '紹介文は準備中です。' %></p>
            <%= link_to '店舗の詳細を見る', shoplist_path(shop.id), class: 'btn btn-shop-detail mt-auto' %>
          </div>
        </article>
      </div>
    <% end %>
    <% if @shops.empty? %>
      <div class="col-12">
        <div class="shop-empty-state">
          <h3>お店が見つかりませんでした</h3>
          <p>店名や地域を変えて、もう一度検索してみてください。</p>
          <%= link_to 'すべてのお店を見る', shoplist_index_path, class: 'btn btn-shop-detail' %>
        </div>
      </div>
    <% end %>
  </div>
</section>
