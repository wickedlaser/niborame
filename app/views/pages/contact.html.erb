<div class="container py-4" style="max-width: 720px;">
  <h1 class="mb-3">お問い合わせ</h1>
  <p class="text-muted">店舗情報の間違いや掲載のご要望などをお送りください。</p>

  <% if @contact_email.blank? %>
    <div class="alert alert-warning" role="alert">
      お問い合わせ先が未設定です。管理者が環境変数 <code>CONTACT_EMAIL</code> を設定すると利用できます。
    </div>
  <% end %>

  <% if @errors.present? %>
    <div class="alert alert-danger" role="alert">
      <ul class="mb-0"><% @errors.each do |error| %><li><%= error %></li><% end %></ul>
    </div>
  <% end %>

  <%= form_with scope: :contact, url: contact_path, method: :post do |form| %>
    <div class="mb-3">
      <%= form.label :name, 'お名前', class: 'form-label' %>
      <%= form.text_field :name, value: @contact[:name], class: 'form-control', required: true, maxlength: 100, autocomplete: 'name' %>
    </div>
    <div class="mb-3">
      <%= form.label :email, 'メールアドレス', class: 'form-label' %>
      <%= form.email_field :email, value: @contact[:email], class: 'form-control', required: true, maxlength: 254, autocomplete: 'email' %>
    </div>
    <div class="mb-3">
      <%= form.label :message, 'お問い合わせ内容', class: 'form-label' %>
      <%= form.text_area :message, value: @contact[:message], class: 'form-control', required: true, maxlength: 4000, rows: 8 %>
    </div>
    <p class="small text-muted">次の画面でメールアプリを開き、内容を確認して送信してください。</p>
    <%= form.submit '確認へ進む', class: 'btn btn-primary', disabled: @contact_email.blank? %>
  <% end %>
</div>
