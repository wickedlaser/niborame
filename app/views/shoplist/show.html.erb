<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @shop.name %> - 詳細情報</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa; /* 背景色を淡いグレーに */
      color: #333;
    }
    .shop-details {
      margin-top: 20px;
    }
    .shop-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #ddd;
      padding-bottom: 10px;
      margin-bottom: 20px;
    }
    .shop-header h1 {
      font-size: 2rem;
      color: #343a40;
    }
    .shop-map {
      height: 400px;
      margin-bottom: 20px;
    }
    .shop-section {
      margin-bottom: 20px;
      padding-bottom: 20px;
      border-bottom: 2px solid #ddd;
    }
    .shop-section h5 {
      margin-bottom: 10px;
      color: #495057;
    }
    .shop-introduction {
      white-space: pre-wrap; /* 改行を反映する */
    }
    .shop-image-container {
      text-align: center;
      margin-bottom: 20px;
    }
    .card {
      border: 1px solid #ccc;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      padding: 20px;
      margin-bottom: 20px;
      background-color: white;
    }
  </style>
</head>
<body>
  <div class="container shop-details">
    <div class="shop-header">
      <h1><%= @shop.name %></h1>
      <a href="/" class="btn btn-secondary">ホームに戻る</a>
    </div>
    <div class="card">
      <div class="shop-image-container shop-section">
        <% if @shop.detail_image_url.present? %>
          <img src="<%= @shop.detail_image_url %>" class="img-fluid" alt="店舗の画像">
        <% else %>
          <p>詳細画像は未登録です。</p>
        <% end %>
      </div>
      <div class="shop-introduction shop-section">
        <h5>紹介</h5>
        <p><%= @shop.introduction %></p>
      </div>
      <div class="shop-genre shop-section">
        <h5>ジャンル</h5>
        <p><%= @shop.genre %></p>
      </div>
      <div class="shop-address shop-section">
        <h5>住所</h5>
        <p><%= @display_address %></p>
      </div>
      <div class="shop-business-hours shop-section">
        <h5>営業時間</h5>
        <p class="shop-business-hours__text"><%= @display_business_hours.presence || '営業時間は未登録です。' %></p>
        <% if @place_details.present? %>
          <p class="small text-muted">店舗情報: <%= link_to 'Google Maps', @google_maps_url, target: '_blank', rel: 'noopener' %></p>
        <% end %>
      </div>
      <% if @map_available %>
        <div id="map" class="shop-map shop-section"></div>
      <% elsif @display_address.present? %>
        <div class="shop-section">
          <h5>地図</h5>
          <%= link_to 'Googleマップで見る', @google_maps_url, target: "_blank", rel: "noopener" %>
        </div>
      <% end %>
    </div>
  </div>
  <% if @map_available %>
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&callback=initMap" async defer></script>
    <script>
      function initMap() {
        var shopLocation = { lat: <%= @latitude %>, lng: <%= @longitude %> };
        var map = new google.maps.Map(document.getElementById('map'), {
          zoom: 15,
          center: shopLocation
        });
        new google.maps.Marker({ position: shopLocation, map: map });
      }
    </script>
  <% end %>
</body>
</html>
