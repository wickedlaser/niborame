<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ラーメンショップ一覧</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <style>
    .shop-details {
      margin-top: 20px;
    }
    .shop-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #ccc;
      padding-bottom: 10px;
      margin-bottom: 20px;
    }
    .shop-header h1 {
      font-size: 2rem;
    }
    .shop-map {
      height: 400px;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>煮干ラーメン屋一覧</h1>
    <div class="mb-3">
      <label for="genre-filter" class="form-label">ジャンルで絞り込み</label>
      <select id="genre-filter" class="form-select">
        <option value="">全て</option>
        <option value="濃厚">濃厚</option>
        <option value="淡麗">淡麗</option>
        <option value="つけ麺">つけ麺</option>
        <option value="汁なし">汁なし</option>
      </select>
    </div>
    <div class="row" id="shops-container">
      <% @shops.each do |shop| %>
        <div class="col-md-4 shop-card" data-genre="<%= shop.genre %>">
          <div class="card mb-4">
            <% if shop.image.attached? %>
              <%= image_tag shop.image, class: "card-img-top", alt: "ラーメンの画像" %>
            <% else %>
              <%= image_tag "https://picsum.photos/300/200", class: "card-img-top", alt: "ラーメンの画像" %>
            <% end %>
            <div class="card-body">
              <h5 class="card-title"><%= shop.title %></h5>
              <p class="card-text"><%= shop.content %></p>
              <p class="card-text">ジャンル: <%= shop.genre %></p>
              <p class="card-text">住所: <%= shop.address %></p>
              <a href="<%= shoplist_path(shop.id) %>" class="btn btn-primary">詳細を見る</a>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const genreFilter = document.getElementById("genre-filter");
      genreFilter.addEventListener("change", function() {
        const selectedGenre = this.value;
        const shopCards = document.querySelectorAll(".shop-card");
        shopCards.forEach(function(card) {
          if (selectedGenre === "" || card.dataset.genre === selectedGenre) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  </script>
</body>
</html>
