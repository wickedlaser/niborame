<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>煮干ラーメン屋リスト</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: url('https://images.pexels.com/photos/5825604/pexels-photo-5825604.jpeg') no-repeat center center fixed;
      background-color: #f0f0f0; /* グレーの背景色 */
      color: #333;
    }

    .navbar {
      background-color: #444 !important; /* グレーの背景色 */
      color: #fff !important; /* テキストの色を白に設定 */
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      padding: 1rem 1rem;
    }

    .navbar-nav .nav-link {
      color: #fff !important; /* ナビゲーションリンクの色を白に設定 */
      padding: 10px 15px; /* パディングを追加 */
      border-bottom: 2px solid transparent; /* 初期状態のボーダーを透明に */
    }

    .navbar-nav .nav-link:hover {
      color: #ccc !important; /* ホバー時の色をライトグレーに設定 */
      border-bottom: 2px solid #fff !important; /* ホバー時のボーダーを白に設定 */
    }

    .shop-card {
      margin-top: 20px;
      border: 1px solid #ccc; /* カード外側の枠色をグレーに */
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      border-radius: 10px;
      overflow: hidden;
      background-color: white;
    }

    .card-img-top {
      height: 200px;
      object-fit: cover;
    }

    .btn-custom {
      background-color: #6c757d;
      border-color: #6c757d;
      color: white;
    }

    .btn-custom:hover {
      background-color: #5a6268;
      border-color: #545b62;
    }

    .container {
      background-color: rgba(255, 255, 255, 0.9);
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .card {
      margin-bottom: 20px; /* カード間の隙間を追加 */
    }
  </style>
</head>
<body>

  <div class="container mt-5">
    <h3 class="mb-4 text-center">煮干ラーメン屋リスト</h3>
    <div class="mb-3">
      <label for="genre-filter" class="form-label">ジャンルで絞り込み</label>
      <select id="genre-filter" class="form-select">
        <option value="">全て</option>
        <option value="濃厚">濃厚</option>
        <option value="淡麗">淡麗</option>
        <option value="つけ麺">つけ麺</option>
        <option value="汁なし">汁なし</option>
      </select>
    </div>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4" id="shops-container">
      <% @shops.each do |shop| %>
        <div class="col shop-card" data-genre="<%= shop.genre %>">
          <div class="card h-100">
            <% if shop.image_url.present? %>
              <%= image_tag shop.image_url, class: "card-img-top", alt: "ラーメンの画像" %>
            <% else %>
              <%= image_tag "https://picsum.photos/300/200", class: "card-img-top", alt: "画像が見つかりません" %>
            <% end %>
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <h5 class="card-title"><%= shop.name %></h5>
                <p class="card-text"><%= shop.introduction %></p>
                <span class="badge bg-primary text-white"><%= shop.genre %></span>
              </div>
              <%= link_to '詳細を見る', shoplist_path(shop.id), class: "btn btn-custom mt-3" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      const genreFilter = document.getElementById("genre-filter");
      genreFilter.addEventListener("change", function() {
        const selectedGenre = this.value;
        const shopCards = document.querySelectorAll(".shop-card");
        shopCards.forEach(function(card) {
          if (selectedGenre === "" || card.dataset.genre === selectedGenre) {
            card.style.display = "block";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  </script>
</body>
</html>
