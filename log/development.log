      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      border-radius: 10px;
      overflow: hidden;
      background-color: white;
    }

    .card-img-top {
      height: 200px;
      object-fit: cover;
    }

    .btn-custom {
      background-color: #6c757d;
      border-color: #6c757d;
      color: white;
    }

    .btn-custom:hover {
      background-color: #5a6268;
      border-color: #545b62;
    }

    .container {
      background-color: rgba(255, 255, 255, 0.9);
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .card {
      margin-bottom: 20px; /* カード間の隙間を追加 */
    }
  </style>
</head>
