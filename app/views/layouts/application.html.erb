<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : "煮干ラーメン屋リスト" %></title>
  <!-- Bootstrap CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome CDN for icons -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: url('https://images.pexels.com/photos/5825604/pexels-photo-5825604.jpeg') no-repeat center center fixed;
      background-color: #f0f0f0; /* グレーの背景色 */
      color: #333;
    }

    .navbar {
      background-color: #444 !important; /* グレーの背景色 */
      color: #fff !important; /* テキストの色を白に設定 */
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      padding: 1rem 1rem;
    }

    .navbar-nav .nav-link {
      color: #fff !important; /* ナビゲーションリンクの色を白に設定 */
      padding: 10px 15px; /* パディングを追加 */
      border-bottom: 2px solid transparent; /* 初期状態のボーダーを透明に */
    }

    .navbar-nav .nav-link:hover {
      color: #ccc !important; /* ホバー時の色をライトグレーに設定 */
      border-bottom: 2px solid #fff !重要！; /* ホバー時のボーダーを白に設定 */
    }

    .shop-card {
      margin-top: 20px;
      border: 1px solid #ccc; /* カード外側の枠色をグレーに */
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      border-radius: 10px;
      overflow: hidden;
      background-color: white;
    }

    .card-img-top {
      height: 200px;
      object-fit: cover;
    }

    .btn-custom {
      background-color: #6c757d;
      border-color: #6c757d;
      color: white;
    }

    .btn-custom:hover {
      background-color: #5a6268;
      border-color: #545b62;
    }

    .container {
      background-color: rgba(255, 255, 255, 0.9);
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .card {
      margin-bottom: 20px; /* カード間の隙間を追加 */
    }
  </style>
</head>
<body>
  <!-- ヘッダー -->
  <nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">煮干ラーメン</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/">ホーム</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/">店舗一覧</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#">お問い合わせ</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container mt-5">
    <%= yield %>
  </div>

  <!-- フッター -->
  <footer class="text-center text-lg-start footer">
    <div class="container p-4">
      <div class="text-center p-3">
        © 2024 煮干ラーメン屋:
        <a class="text-light" href="#">niboramen.com</a>
      </div>
    </div>
  </footer>

  <!-- Bootstrap JS CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Font Awesome JS CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/js/all.min.js"></script>
</body>
</html>
