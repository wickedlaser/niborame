<% content_for :title, "#{@shop.name} | niborame" %>
  <div class="shop-details">
    <div class="shop-header">
      <h1><%= @shop.name %></h1>
      <a href="/" class="btn btn-secondary">ホームに戻る</a>
    </div>
    <div class="shop-detail-content">
      <div class="shop-image-container shop-section">
        <% if @shop.detail_image_url.present? %>
          <img src="<%= @shop.detail_image_url %>" class="img-fluid" alt="店舗の画像">
        <% else %>
          <p>詳細画像は未登録です。</p>
        <% end %>
      </div>
      <% if @place_rating.present? %>
        <div class="shop-rating shop-section">
          <h5>Google Mapsの評価</h5>
          <p class="mb-1"><strong>★ <%= number_with_precision(@place_rating, precision: 1) %></strong><% if @place_rating_count.present? %>（<%= number_with_delimiter(@place_rating_count) %>件）<% end %></p>
          <p class="small mb-0"><%= link_to 'Google Mapsで評価・店舗情報を見る', @google_maps_url, target: '_blank', rel: 'noopener' %></p>
        </div>
      <% end %>
      <% if @place_photos.present? %>
        <div class="shop-place-photos shop-section">
          <h5>Google Mapsの写真</h5>
          <div class="row g-3">
            <% @place_photos.each do |photo| %>
              <figure class="col-12 col-md-4 mb-0">
                <%= image_tag photo[:url], alt: "#{@shop.name}の写真（Google Maps）", class: 'img-fluid rounded', loading: 'lazy' %>
                <figcaption class="small mt-2">
                  <% photo[:attributions].each do |attribution| %>
                    <span>写真提供: <% if attribution[:uri].present? %><%= link_to attribution[:name].presence || '投稿者', attribution[:uri], target: '_blank', rel: 'noopener' %><% else %><%= attribution[:name] %><% end %></span>
                  <% end %>
                  <%= link_to 'Google Mapsで写真を見る', @google_maps_url, target: '_blank', rel: 'noopener', class: 'd-block' %>
                </figcaption>
              </figure>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="shop-introduction shop-section">
        <h5>紹介</h5>
        <p><%= @shop.introduction %></p>
      </div>
      <div class="shop-genre shop-section">
        <h5>ジャンル</h5>
        <p><%= @shop.genre %></p>
      </div>
      <div class="shop-address shop-section">
        <h5>住所</h5>
        <p><%= @display_address %></p>
      </div>
      <div class="shop-business-hours shop-section">
        <h5>営業時間</h5>
        <p class="shop-business-hours__text"><%= @display_business_hours.presence || '営業時間は未登録です。' %></p>
        <% if @place_details.present? %>
          <p class="small text-muted">店舗情報: <%= link_to 'Google Maps', @google_maps_url, target: '_blank', rel: 'noopener' %></p>
        <% end %>
      </div>
      <% if @map_available %>
        <div id="map" class="shop-map shop-section"></div>
      <% elsif @display_address.present? %>
        <div class="shop-section">
          <h5>地図</h5>
          <%= link_to 'Googleマップで見る', @google_maps_url, target: "_blank", rel: "noopener" %>
        </div>
      <% end %>
    </div>
  </div>
  <% if @map_available %>
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['GOOGLE_MAPS_API_KEY'] %>&callback=initMap" async defer></script>
    <script>
      function initMap() {
        var shopLocation = { lat: <%= @latitude %>, lng: <%= @longitude %> };
        var map = new google.maps.Map(document.getElementById('map'), {
          zoom: 15,
          center: shopLocation
        });
        new google.maps.Marker({ position: shopLocation, map: map });
      }
    </script>
  <% end %>
